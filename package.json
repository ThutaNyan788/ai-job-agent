{
  "name": "harness-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-jobs.ts",
    "test": "tsx --test shared/candidate.test.ts web/src/interview.test.ts harness/jobs.test.ts harness/application-state.test.ts harness/cv.test.ts",
    "docs": "vitepress dev lessons --port 5174",
    "docs:build": "vitepress build lessons",
    "docs:preview": "vitepress preview lessons --port 4174"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.70",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@zegocloud/zego-uikit-prebuilt": "^2.17.3",
    "ai": "^6.0.202",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "esbuild@0.21.5": true
  }
}
